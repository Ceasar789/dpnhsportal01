# Copy to frontend/.env and fill in. Vite reads this from the frontend
# workspace root, not the repository root.
#
# The first two are PUBLIC by design: the anon key is meant to reach the
# browser, and Row Level Security is what protects the data behind it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the EduScribe API lives. A URL, not a secret.
# The Gemini key is NOT here any more: it lives in backend/.env, because
# Vite inlines every VITE_* variable into the shipped bundle.
VITE_API_BASE_URL=http://localhost:3001
