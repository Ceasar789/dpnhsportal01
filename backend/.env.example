# Copy to backend/.env. NEVER prefix anything here with VITE_ — that prefix
# is what put the Gemini key in the browser bundle in the first place.
# backend/.env is gitignored; this file is not, so it carries no values.

PORT=3001

# Comma-separated. The deployed frontend origin goes here too.
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co

# Used only to verify a caller's session token.
SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security completely. Server only, forever.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billable. This is the reason this service exists.
GEMINI_API_KEY=your-gemini-key
