{
  "name": "eduscribe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "EduScribe — AI-assisted lesson planning and learning resources management. npm workspaces: frontend (React + Vite) and backend (database, policies, operational scripts).",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:testcases": "node tools/build-test-cases-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pdfmake": "^0.3.11"
  }
}
