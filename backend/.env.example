# Copy to backend/.env. NEVER prefix anything here with VITE_ — that prefix
# is what put the Gemini key in the browser bundle in the first place.
# backend/.env is gitignored; this file is not, so it carries no values.

PORT=3001

# Comma-separated. The deployed frontend origin goes here too.
CORS_ORIGINS=http://localhost:5173

# Trusted frontend origin used in Supabase invitation redirects.
APP_URL=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co

# Used only to verify a caller's session token.
SUPABASE_ANON_KEY=your-anon-key
# AI_LESSON_PLAN_SAVE_ENABLED=1  # Local development only; leave unset until the dev RPC is installed.
# AI_WEEKLY_WORKSHEET_SAVE_ENABLED=1  # Local development only; enable after the weekly save RPC is verified.
# AI_SAVE_DEV_PROJECT_REF=your-20-character-dev-ref  # Required for a hosted dev Supabase target.
# AI_SAVE_ALLOW_TEST_DATA_PROJECT=1  # Local-only override for the blocked ref; test data only.

# Bypasses Row Level Security completely. Server only, forever.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billable. This is the reason this service exists.
GEMINI_API_KEY=your-gemini-key

# Optional weekly worksheet provider chain. Gemini remains the default when unset.
# WEEKLY_WORKSHEET_PROVIDERS=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# NVIDIA_ENABLE_THINKING=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MAX_TOKENS=4096
# WEEKLY_WORKSHEET_PROVIDER_TIMEOUT_MS=90000
# Set WEEKLY_WORKSHEET_PROVIDER=groq only for local development.
WEEKLY_WORKSHEET_PROVIDER=gemini
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=
# WEEKLY_DEBUG_CAPTURE=
