# Copy to frontend/.env and fill in. Vite reads this from the frontend
# workspace root, not the repository root.
#
# The first two are PUBLIC by design: the anon key is meant to reach the
# browser, and Row Level Security is what protects the data behind it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# This one is NOT public, and currently ships in the bundle anyway, because
# Vite inlines every VITE_* variable at build time. Moving it behind the
# Node service is the open task — see backend/README.md.
VITE_GEMINI_API_KEY=your-gemini-key
